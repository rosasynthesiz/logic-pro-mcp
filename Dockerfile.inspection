# Schema inspection only. This container cannot control Logic Pro.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY logic_mcp ./logic_mcp
COPY scripts/check_inspection.py ./scripts/check_inspection.py
RUN uv sync --frozen --no-dev
ENV LOGIC_MCP_INSPECT_ONLY=1
CMD ["uv", "run", "--no-sync", "logic-pro-mcp"]
